# Build context for `COPY . .` (builder only). The runner copies
# standalone + public + static. Next.js will load any .env / .env.production
# that reaches the builder and can bake NEXT_PUBLIC_* into the client.

# Dependencies and caches
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.next
out
/build
*.tsbuildinfo
next-env.d.ts

# Local / example env — never copy; Dockerfile ARGs set build-time public flags
.env
.env.*

# Local mock-upstream
/dev

# Tests and lint (not used by `next build`)
coverage
.nyc_output
**/*.test.ts
**/*.test.tsx
**/*.test.mjs
**/__tests__
vitest.config.ts
vitest.setup.ts
eslint.config.mjs
.prettierrc

# Docs and contributor files
README.md
CONTRIBUTING.md
LICENSE
docs

# Deploy / compose / k8s (not part of the Next image)
/helm
/scripts
docker-compose*.yml
Dockerfile
Dockerfile.nginx
.dockerignore
docker-build.sh
k8s-secrets-template.yaml
values-production.yaml.example
*.pem
secrets/
.secrets

# CI, VCS, editors, OS
.git
.gitignore
.github
.gitlab-ci.yml
.travis.yml
.vercel
.cursor
.claude
.playwright*
.vscode
.idea
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini

# Logs and temp
/logs
*.log
tmp/
temp/
*.tmp
