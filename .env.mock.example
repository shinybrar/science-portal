# Overlay for local mock-upstream (npm run mock:upstream).
# Copy these URL lines into .env.local. Keep NEXT_USE_CANFAR / OIDC secrets as-is.
# Storage bases MUST end with /cavern/nodes/home/

LOGIN_API=http://127.0.0.1:4010
SKAHA_API=http://127.0.0.1:4010
SRC_SKAHA_API=http://127.0.0.1:4010
SERVICE_STORAGE_API=http://127.0.0.1:4010/cavern/nodes/home/
SRC_CAVERN_API=http://127.0.0.1:4010/cavern/nodes/home/

NEXT_PUBLIC_LOGIN_API=http://127.0.0.1:4010
NEXT_PUBLIC_SKAHA_API=http://127.0.0.1:4010
NEXT_PUBLIC_SRC_SKAHA_API=http://127.0.0.1:4010
NEXT_PUBLIC_SRC_CAVERN_API=http://127.0.0.1:4010/cavern/nodes/home/
